# Copy this file to .env.local (do NOT commit .env.local)
# Vite requires env variables to begin with VITE_

VITE_FIREBASE_API_KEY=REPLACE_WITH_YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=REPLACE_WITH_YOUR_MEASUREMENT_ID

# Optional: switch on to fetch data from your backend at /api/analytics/dashboard
VITE_USE_REAL_ANALYTICS=true
VITE_ANALYTICS_URL=http://localhost:3001/api/analytics/dashboard

# Server-side (do NOT commit your service-account path):
# Example: GA4_PROPERTY_ID=properties/123456789  OR GA4_PROPERTY_ID=123456789
# Path to the downloaded service account JSON (set this in the server environment, do NOT commit):
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Optional: if you created a custom dimension for department/user property, set its API name here
# e.g. GA4_DEPARTMENT_DIMENSION=userProperty:department
# GA4_DEPARTMENT_DIMENSION=userProperty:department
