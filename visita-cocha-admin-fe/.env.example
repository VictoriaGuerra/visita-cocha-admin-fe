# ====================================
# CONFIGURACIÓN DEL BACKEND DE VISITA COCHA
# ====================================

# URL base del backend (proyecto de mejoras)
# Por defecto: http://localhost:3000
# Cámbialo si tu backend usa otro puerto
VITE_API_BASE_URL=http://localhost:3000

# Habilitar uso del backend real (true) o usar datos mock (false)
# Para conectar con tu backend real, cambia a: true
VITE_USE_BACKEND=true

# ====================================
# INSTRUCCIONES
# ====================================
# 1. Copia este archivo como .env
# 2. Ajusta VITE_API_BASE_URL según tu backend
# 3. Cambia VITE_USE_BACKEND a true para usar API real
# 4. Reinicia el servidor de desarrollo (npm run dev)
